<Project>
  <!-- UnityEnginePath drives where the build (and the CameraUnlock.Core.Unity
       submodule project, which reads this file because PropertyGroups in
       GreenHellHeadTracking.csproj don't propagate to ProjectReferences)
       resolves UnityEngine.*.dll.

       It resolves to the generated stub assemblies in src/.../libs - produced
       by scripts/bootstrap-build-deps.ps1 from the checked-in UnityStubs.cs -
       so the build NEVER depends on a local Green Hell install. This is
       deliberate: building against the game's real DLLs locally while CI builds
       against the stubs is exactly how a build passes locally and then fails on
       a runner. Both paths build against these stubs.

       A caller can still override with -p:UnityEnginePath=... (e.g. to validate
       the stubs against a real game install), but that is an explicit opt-in,
       never the default. -->
  <PropertyGroup Condition="'$(UnityEnginePath)' == ''">
    <UnityEnginePath>$(MSBuildThisFileDirectory)src\GreenHellHeadTracking\libs</UnityEnginePath>
  </PropertyGroup>
</Project>
