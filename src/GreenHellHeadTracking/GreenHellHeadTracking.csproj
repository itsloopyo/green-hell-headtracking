<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>GreenHellHeadTracking</AssemblyName>
    <RootNamespace>GreenHellHeadTracking</RootNamespace>
    <Version>1.3.0</Version>
    <LangVersion>9.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <Authors>itsloopyo</Authors>
    <Description>Head tracking mod for Green Hell</Description>
    <!-- Version conflicts between the Unity reference assemblies are expected. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3243</MSBuildWarningsAsMessages>
    <!-- An unresolved reference is only a warning by default, so a mistyped
         -p:UnityEnginePath= would compile on and report hundreds of CS0246
         "type not found" errors instead of the one line naming the cause. -->
    <MSBuildWarningsAsErrors>$(MSBuildWarningsAsErrors);MSB3245</MSBuildWarningsAsErrors>
  </PropertyGroup>

  <!-- CameraUnlock shared libraries -->
  <ItemGroup>
    <ProjectReference Include="..\..\cameraunlock-core\csharp\src\CameraUnlock.Core\CameraUnlock.Core.csproj" />
    <ProjectReference Include="..\..\cameraunlock-core\csharp\src\CameraUnlock.Core.Unity\CameraUnlock.Core.Unity.csproj" />
    <ProjectReference Include="..\..\cameraunlock-core\csharp\src\CameraUnlock.Core.Unity.Harmony\CameraUnlock.Core.Unity.Harmony.csproj" />
  </ItemGroup>

  <!-- MelonLoader and Harmony come from the vendored MelonLoader zip, which
       scripts/bootstrap-build-deps.ps1 extracts into libs\. A game install is
       never consulted for them: vendored is the source of truth. -->
  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>libs\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>libs\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Engine and game reference assemblies, resolved from exactly one place.
       UnityEnginePath defaults to the generated stubs in libs\ (see
       Directory.Build.props), so a contributor who owns Green Hell and a CI
       runner that does not compile against byte-identical assemblies.
       -p:UnityEnginePath=<install>\GH_Data\Managed points the build at the real
       game, which is how the stubs get validated. There is deliberately no
       autodetection of a Steam install: a second reference source that wins
       silently is how a build passes locally and then fails on a runner. -->
  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(UnityEnginePath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityEnginePath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(UnityEnginePath)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(UnityEnginePath)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(UnityEnginePath)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(UnityEnginePath)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(UnityEnginePath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="libs\**" />
    <None Remove="libs\**" />
  </ItemGroup>
</Project>
